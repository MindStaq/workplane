{
  "name": "@workplane/server",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts"
  },
  "nx": {
    "targets": {
      "serve": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "node --import tsx {projectRoot}/src/index.ts",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  }
}
