{
  "name": "workplane",
  "version": "0.3.0",
  "description": "Durable execution plane for routing work across trusted nodes",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MindStaq/workplane.git"
  },
  "homepage": "https://mindstaq.github.io/workplane/",
  "bugs": {
    "url": "https://github.com/MindStaq/workplane/issues"
  },
