{
  "name": "@workplane/node",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "type:app",
      "runtime:node",
      "publish:private"
    ],
    "targets": {
      "serve": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "node --import tsx {projectRoot}/src/index.ts",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  }
}
