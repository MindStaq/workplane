DATABASE_URL=postgres://postgres:postgres@localhost:5432/workplane
WORKPLANE_SERVER_URL=http://localhost:8787
WORKPLANE_SERVER_PORT=8787
WORKPLANE_WORKSPACE_ROOT=.workplane/workspaces

# Fleet auth (set the same values on server, nodes, and operator CLI)
WORKPLANE_NODE_TOKEN=change-me-node-token
WORKPLANE_OPERATOR_TOKEN=change-me-operator-token

# Node
WORKPLANE_NODE_NAME=local-node-1
WORKPLANE_NODE_CAPABILITIES=shell,git,node,typescript,aider,ollama,codex,claude-code
WORKPLANE_POLL_INTERVAL_MS=3000

# Optional secret forwarding allowlist (comma-separated)
WORKPLANE_ENV_ALLOWLIST=OPENAI_API_KEY,ANTHROPIC_API_KEY,GITHUB_TOKEN

# Harness binary overrides
WORKPLANE_CODEX_BIN=codex
WORKPLANE_CLAUDE_CODE_BIN=claude
