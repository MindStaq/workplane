# Copy to `.env.local` for local development (see README and docs/deployment/FLEET.md).
# Loaded by dotenv: `.env` first, then `.env.local` overrides.
#
# Not every variable applies to every binary. Set only what you run:
#
#   workplane skill run …     → no Postgres; API keys only (see @workplane/workplans)
#   workplane (fleet CLI)     → WORKPLANE_SERVER_URL, optional OPERATOR_TOKEN
#   workplane-server          → DATABASE_URL (+ migrate once); DBOS vars only if enabled
#   workplane-node            → WORKPLANE_SERVER_URL, NODE_*; optional NODE_TOKEN
#
# Postgres is required for the control plane (server + migrate), not for local
# workplans/skills. Docker via `pnpm dev:db` is optional — any reachable Postgres works.
# DBOS durability is optional on top of that (see bottom).

# -----------------------------------------------------------------------------
# Fleet connectivity (server, nodes, CLI)
# -----------------------------------------------------------------------------

# Base URL of the control plane. Used by nodes and the operator CLI when
# submitting tasks. For a personal fleet, use the reachable host (e.g. Tailscale IP).
WORKPLANE_SERVER_URL=http://localhost:8787

# -----------------------------------------------------------------------------
# Fleet auth (optional for localhost dev)
# -----------------------------------------------------------------------------
# Generate long random secrets and use the same values on server, every node,
# and the operator CLI. When unset, auth checks are disabled (localhost dev only).

# Bearer token nodes present when registering and polling for work.
WORKPLANE_NODE_TOKEN=change-me-node-token

# Bearer token the CLI uses for operator actions (submit tasks, inspect runs).
WORKPLANE_OPERATOR_TOKEN=change-me-operator-token

# -----------------------------------------------------------------------------
# Control plane — workplane-server only (requires Postgres)
# -----------------------------------------------------------------------------

# Connection string for the workplane app schema (tasks, runs, logs, etc.).
# Required by workplane-server and workplane-db-migrate. Not used by local
# workplan/skill runs. Create the database first (`pnpm dev:db` or your own Postgres).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workplane

# HTTP port the workplane server listens on.
WORKPLANE_SERVER_PORT=8787

# -----------------------------------------------------------------------------
# Node worker — workplane-node
# -----------------------------------------------------------------------------

# Human-readable label for this node in the fleet (shown in logs and routing).
WORKPLANE_NODE_NAME=local-node-1

# Comma-separated capability tags this node advertises. Tasks declare required
# capabilities; the server routes work only to matching nodes. Examples:
# shell, git, node, typescript, aider, ollama, codex, claude-code, gpu
WORKPLANE_NODE_CAPABILITIES=shell,git,node,typescript,aider,ollama,codex,claude-code

# How often (ms) the node polls the server for new task assignments.
WORKPLANE_POLL_INTERVAL_MS=3000

# Root directory where nodes clone repos and create per-run workspaces
# (one subdirectory per run). Relative paths resolve from the process cwd.
WORKPLANE_WORKSPACE_ROOT=.workplane/workspaces

# When `true`, mirror node log output to the local terminal in addition to
# streaming it to the control plane. Useful for debugging; leave off in production.
WORKPLANE_NODE_LOG_MIRROR=true

# -----------------------------------------------------------------------------
# Optional — secret forwarding (node)
# -----------------------------------------------------------------------------

# Comma-separated env var names the node may forward into task subprocesses
# (e.g. API keys for harnesses). Only listed keys are passed; PATH and HOME are
# always included. Leave empty to forward the full process environment.
WORKPLANE_ENV_ALLOWLIST=OPENAI_API_KEY,ANTHROPIC_API_KEY,GITHUB_TOKEN

# -----------------------------------------------------------------------------
# Optional — harness binary overrides (node)
# -----------------------------------------------------------------------------

# Executable name or path for the Codex CLI (used by the codex adapter).
WORKPLANE_CODEX_BIN=codex

# Executable name or path for the Claude Code CLI (used by the claude-code adapter).
WORKPLANE_CLAUDE_CODE_BIN=claude

# -----------------------------------------------------------------------------
# Optional — DBOS durability (workplane-server only)
# -----------------------------------------------------------------------------
# Default: unset. The server uses in-process VanillaWorkflows — no DBOS import,
# no DBOS system tables, no conductor key. Enable only when you want crash-safe
# workflow replay (uses the same DATABASE_URL for DBOS system tables).
#
# WORKPLANE_USE_DBOS=true
# DBOS_APPLICATION_NAME=workplane-dev
# DBOS_CONDUCTOR_KEY=change-me-dbos-conductor-key
# DBOS_CONDUCTOR_URL=https://cloud.dbos.dev
