{
  "name": "@workplane/mcp",
  "version": "0.6.0",
  "description": "MCP server for operating a Workplane fleet from Claude Code, Cursor and other MCP clients",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MindStaq/workplane.git"
  },
  "keywords": [
    "workplane",
    "mcp",
    "model-context-protocol",
    "agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "workplane-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@workplane/client": "workspace:*",
    "@workplane/types": "workspace:*"
  }
}
