# Copy to `.env.local` (Next.js loads it). `pnpm dev:all` sets sensible defaults for local development.

# Control plane the server-side proxy forwards to.
WORKPLANE_SERVER_URL=http://localhost:8787

# Operator token the proxy attaches to every request. Server-only: never exposed to the browser.
# Must match WORKPLANE_OPERATOR_TOKEN on the control plane (leave both unset for open localhost dev).
WORKPLANE_OPERATOR_TOKEN=
