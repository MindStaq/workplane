{
  "name": "workplane",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm --filter workplane build",
    "build:libs": "pnpm --filter \"@workplane/types\" --filter \"@workplane/core\" --filter \"@workplane/adapter-sdk\" --filter \"@workplane/adapter-shell\" --filter \"@workplane/adapter-aider\" --filter \"@workplane/adapter-ollama\" --filter \"@workplane/adapter-harness\" --filter \"@workplane/adapter-claude-code\" --filter \"@workplane/adapter-codex\" --filter \"@workplane/workplans\" --filter \"@workplane/agent-skills\" --filter \"@workplane/dbos\" build",
    "dev:server": "node --import tsx packages/server/src/index.ts",
    "dev:node": "node --import tsx packages/node/src/index.ts",
    "dev:cli": "node --import tsx packages/cli/src/index.ts",
    "dev:db": "docker compose up -d postgres",
    "db:migrate": "node --import tsx packages/db/src/migrate.ts",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.config.sqlite.ts",
    "db:generate": "pnpm db:generate:pg && pnpm db:generate:sqlite",
    "test": "node --import tsx --test packages/core/src/*.test.ts packages/server/src/*.test.ts packages/adapter-sdk/src/*.test.ts packages/node/src/*.test.ts packages/workplans/src/*.test.ts packages/agent-skills/src/*.test.ts packages/db/src/*.test.ts",
    "test:auth": "node --import tsx scripts/test-api-auth.ts",
    "uat:shell": "node --import tsx scripts/uat-shell-task.ts",
    "uat:aider": "node --import tsx scripts/uat-aider-task.ts",
    "uat:inference": "node --import tsx scripts/uat-inference-task.ts",
    "uat": "pnpm uat:shell",
    "test:submit-local": "node --import tsx scripts/test-submit-local.ts",
    "uat:interactive": "node --import tsx scripts/uat-interactive-task.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@dbos-inc/dbos-sdk": "^4.18.10",
    "cron-parser": "^5.1.0",
    "dotenv": "^16.6.1",
    "node-pty": "^1.1.0",
    "ollama": "^0.5.16",
    "openai": "^4.103.0",
    "pg": "^8.16.0",
    "zod": "^3.25.56"
  }
}
