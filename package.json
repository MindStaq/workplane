{
  "name": "workplane-monorepo",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "nx run-many -t build",
    "dev:server": "node --import tsx apps/server/src/index.ts",
    "dev:node": "node --import tsx apps/node/src/index.ts",
    "dev:cli": "node --import tsx apps/cli/src/index.ts",
    "dev:web": "nx serve @workplane/web",
    "dev:all": "node scripts/dev-all.mjs --seed",
    "seed:dev": "node --import tsx scripts/seed-dev-data.ts",
    "dev:db": "docker compose up -d postgres",
    "db:migrate": "node --import tsx libs/db/src/migrate.ts",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.config.sqlite.ts",
    "db:generate": "pnpm db:generate:pg && pnpm db:generate:sqlite",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "pack:check": "node --import tsx scripts/pack-manifest.ts",
    "pack:snapshot": "node --import tsx scripts/pack-manifest.ts --write",
    "smoke:install": "node scripts/smoke-install.mjs",
    "smoke:libs": "node scripts/smoke-libs.mjs",
    "rehearse:publish": "node scripts/rehearse-publish.mjs",
    "check:web-boundaries": "node scripts/check-web-boundaries.mjs",
    "test:e2e": "nx e2e @workplane/web",
    "test:auth": "node --import tsx scripts/test-api-auth.ts",
    "uat:shell": "node --import tsx scripts/uat-shell-task.ts",
    "uat:aider": "node --import tsx scripts/uat-aider-task.ts",
    "uat:inference": "node --import tsx scripts/uat-inference-task.ts",
    "uat": "pnpm uat:shell",
    "test:submit-local": "node --import tsx scripts/test-submit-local.ts",
    "uat:interactive": "node --import tsx scripts/uat-interactive-task.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "nx": "23.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "verdaccio": "^6.10.4",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@dbos-inc/dbos-sdk": "^4.18.10",
    "cron-parser": "^5.1.0",
    "dotenv": "^16.6.1",
    "node-pty": "^1.1.0",
    "ollama": "^0.5.16",
    "openai": "^4.103.0",
    "pg": "^8.16.0",
    "zod": "^3.25.56"
  }
}
